@model EnrolmentsPageViewModel
@{
    var ev = Model.Event;
    ViewData["Title"] = "Enrolments - " + ev.Name;
    var statuses = new[] { "Confirmed", "Pending", "Cancelled" };
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Organiser" asp-action="Events">My events</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ev.Name</li>
    </ol>
</nav>

<div class="page-head d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
        <h1 class="display-title">Enrolments</h1>
        <p class="text-muted mb-0">Everyone who has entered <strong>@ev.Name</strong>, with their category and status.</p>
    </div>
    <a class="btn btn-outline-rd" asp-controller="OrganiserResults" asp-action="Index" asp-route-eventId="@ev.EventId"><i class="bi bi-trophy"></i> Enter results</a>
</div>

@if (Model.Enrolments.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-people"></i>
        <h2>No one has entered yet</h2>
        <p>When Participants enrol, they will appear here.</p>
    </div>
}
else
{
    <p class="text-muted">@Model.Enrolments.Count enrolment@(Model.Enrolments.Count == 1 ? "" : "s")</p>
    <div class="card table-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Participant</th>
                        <th>Category</th>
                        <th>Enrolled on</th>
                        <th>Status</th>
                        <th class="text-end">Change status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Enrolments)
                    {
                        <tr>
                            <td class="fw-semibold">@e.ParticipantName<div class="small text-muted">@e.ParticipantEmail</div></td>
                            <td>@e.CategoryName</td>
                            <td>@Format.Date(e.EnrolmentDate)</td>
                            <td><partial name="_StatusBadge" model="e.Status" /></td>
                            <td class="text-end">
                                <form asp-action="Status" asp-route-eventId="@ev.EventId" asp-route-id="@e.EnrolmentId" method="post" class="d-inline-flex gap-2">
                                    <select name="status" class="form-select form-select-sm" aria-label="New status">
                                        @foreach (var s in statuses)
                                        {
                                            <option value="@s" selected="@(string.Equals(s, e.Status, StringComparison.OrdinalIgnoreCase))">@s</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-rd">Update</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
