@model CategoryFormViewModel
@{
    ViewData["Title"] = "Edit category";
    var eventId = ViewContext.RouteData.Values["eventId"];
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Organiser" asp-action="Events">My events</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-route-eventId="@eventId">Categories</a></li>
        <li class="breadcrumb-item active" aria-current="page">Edit</li>
    </ol>
</nav>

<div class="page-head">
    <h1 class="display-title">Edit category</h1>
    @if (ViewData["EventName"] != null)
    {
        <p class="text-muted mb-0">For <strong>@ViewData["EventName"]</strong></p>
    }
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-eventId="@eventId" asp-route-id="@Model.Id" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-6 col-md-3">
                    <label asp-for="MinAge" class="form-label"></label>
                    <input asp-for="MinAge" type="number" min="0" max="120" class="form-control" />
                    <span asp-validation-for="MinAge" class="text-danger small"></span>
                </div>
                <div class="col-6 col-md-3">
                    <label asp-for="MaxAge" class="form-label"></label>
                    <input asp-for="MaxAge" type="number" min="0" max="120" class="form-control" />
                    <span asp-validation-for="MaxAge" class="text-danger small"></span>
                </div>
                <div class="col-6 col-md-3">
                    <label asp-for="Distance" class="form-label"></label>
                    <input asp-for="Distance" type="number" step="0.1" min="0" class="form-control" />
                    <span asp-validation-for="Distance" class="text-danger small"></span>
                </div>
                <div class="col-6 col-md-3">
                    <label asp-for="EntryFee" class="form-label"></label>
                    <input asp-for="EntryFee" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="EntryFee" class="text-danger small"></span>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-rd btn-lg">Save changes</button>
                <a class="btn btn-outline-secondary btn-lg" asp-action="Index" asp-route-eventId="@eventId">Cancel</a>
            </div>
        </form>
    </div>
</div>
