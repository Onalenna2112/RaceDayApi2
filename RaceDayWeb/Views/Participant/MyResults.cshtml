@model List<MyResult>
@{
    ViewData["Title"] = "My results";
}
<div class="page-head">
    <h1 class="display-title">My results</h1>
    <p class="text-muted mb-0">Your race history. Results appear here after the organiser publishes them.</p>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-trophy"></i>
        <h2>No results yet</h2>
        <p>When an organiser records your finish time, it will show up here.</p>
        <a class="btn btn-rd" asp-controller="Participant" asp-action="MyEvents">See my events</a>
    </div>
}
else
{
    <div class="card table-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Finish time</th>
                        <th>Position</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@r.EventName</td>
                            <td>@Format.Date(r.EventDate)</td>
                            <td>@r.CategoryName</td>
                            <td class="finish-time">@r.FinishTime</td>
                            <td>
                                @if (r.Position <= 3)
                                {
                                    <i class="bi bi-trophy-fill podium podium-@r.Position"></i>
                                }
                                <strong>@Format.Ordinal(r.Position)</strong> <span class="text-muted">of @r.TotalFinishers</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
