@model List<MyEnrolment>
@{
    ViewData["Title"] = "My events";
}
<div class="page-head">
    <h1 class="display-title">My events</h1>
    <p class="text-muted mb-0">Every event you have entered, and where your enrolment stands.</p>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-calendar-plus"></i>
        <h2>You have not entered any events yet</h2>
        <p>Browse the upcoming events and pick one that suits you.</p>
        <a class="btn btn-rd" asp-controller="Events" asp-action="Index">Find events</a>
    </div>
}
else
{
    <div class="card table-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td><a asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId" class="fw-semibold">@e.EventName</a></td>
                            <td>@Format.DateTimeText(e.EventDate)</td>
                            <td>@e.Location</td>
                            <td>@e.CategoryName</td>
                            <td><partial name="_StatusBadge" model="e.Status" /></td>
                            <td class="text-end">
                                <form asp-controller="Participant" asp-action="CancelEnrolment" method="post" class="d-inline" data-confirm="Cancel your enrolment for @(e.EventName)?">
                                    <input type="hidden" name="enrolmentId" value="@e.EnrolmentId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-x-circle"></i> Cancel</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
