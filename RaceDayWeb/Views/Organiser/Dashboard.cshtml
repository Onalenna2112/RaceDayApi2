@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var maxEnrolments = Model.Events.Count == 0 ? 1 : Math.Max(1, Model.Events.Max(e => e.EnrolmentCount));
}
<div class="page-head d-flex flex-wrap justify-content-between align-items-end gap-2">
    <div>
        <h1 class="display-title">Organiser dashboard</h1>
        <p class="text-muted mb-0">A summary of your events, enrolments and what is coming up.</p>
    </div>
    <a class="btn btn-rd" asp-action="CreateEvent"><i class="bi bi-plus-lg"></i> Create event</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat-tile">
            <i class="bi bi-calendar-event"></i>
            <span class="stat-value">@Model.Events.Count</span>
            <span class="stat-label">Events created</span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-tile">
            <i class="bi bi-people-fill"></i>
            <span class="stat-value">@Model.TotalEnrolments</span>
            <span class="stat-label">Total enrolments</span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-tile">
            <i class="bi bi-hourglass-split"></i>
            <span class="stat-value">@Model.Upcoming.Count</span>
            <span class="stat-label">Upcoming events</span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-tile stat-accent">
            <i class="bi bi-flag-fill"></i>
            @if (Model.NextEvent != null)
            {
                <span class="stat-value stat-small">@Format.Date(Model.NextEvent.EventDate)</span>
                <span class="stat-label">Next: @Model.NextEvent.Name</span>
            }
            else
            {
                <span class="stat-value stat-small">None</span>
                <span class="stat-label">No upcoming event</span>
            }
        </div>
    </div>
</div>

@if (Model.Events.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-calendar-plus"></i>
        <h2>You have not created any events yet</h2>
        <p>Create your first event and Participants can start entering.</p>
        <a class="btn btn-rd" asp-action="CreateEvent">Create your first event</a>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card table-card">
                <div class="card-header-rd">Upcoming event dates</div>
                @if (Model.Upcoming.Count == 0)
                {
                    <p class="p-3 mb-0 text-muted">None of your events are coming up. Create a new event to get started.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr><th>Event</th><th>Date</th><th>Enrolments</th><th class="text-end">Manage</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var e in Model.Upcoming)
                                {
                                    <tr>
                                        <td class="fw-semibold">@e.Name<div class="small text-muted">@e.Location</div></td>
                                        <td>@Format.DateTimeText(e.EventDate)</td>
                                        <td><span class="count-pill">@e.EnrolmentCount</span></td>
                                        <td class="text-end">
                                            <a class="btn btn-sm btn-outline-rd" asp-controller="OrganiserEnrolments" asp-action="Index" asp-route-eventId="@e.EventId">Enrolments</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card">
                <div class="card-header-rd">Enrolments per event</div>
                <div class="card-body">
                    @foreach (var e in Model.Events.OrderByDescending(x => x.EnrolmentCount).Take(8))
                    {
                        var width = (int)Math.Round(100.0 * e.EnrolmentCount / maxEnrolments);
                        <div class="bar-row">
                            <div class="d-flex justify-content-between small">
                                <span class="text-truncate pe-2">@e.Name</span>
                                <strong>@e.EnrolmentCount</strong>
                            </div>
                            <div class="bar-track"><div class="bar-fill" style="width: @(width)%"></div></div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
