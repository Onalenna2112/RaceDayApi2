@{
    var code = ViewData["Code"] is int c ? c : 404;
    ViewData["Title"] = code == 404 ? "Page not found" : "Something went wrong";
}
<div class="message-page">
    <i class="bi bi-signpost-2-fill message-icon"></i>
    @if (code == 404)
    {
        <h1 class="display-title">Page not found</h1>
        <p class="lead">We could not find the page you were looking for. It may have moved, or the link may be wrong.</p>
    }
    else
    {
        <h1 class="display-title">That did not work</h1>
        <p class="lead">The request could not be completed. Please go back and try again.</p>
    }
    <a class="btn btn-rd" asp-controller="Home" asp-action="Index">Back to the start</a>
</div>
