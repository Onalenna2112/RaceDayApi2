@model EventFilterViewModel
@{
    ViewData["Title"] = "Find events";
}
<div class="page-head">
    <h1 class="display-title">Upcoming events</h1>
    <p class="text-muted mb-0">Find your next run, walk or ride and enter in seconds.</p>
</div>

<form asp-action="Index" method="get" class="filter-bar">
    <div class="row g-2 align-items-end">
        <div class="col-lg-4">
            <label asp-for="Search" class="form-label">Search</label>
            <input asp-for="Search" class="form-control" placeholder="Event name or place" />
        </div>
        <div class="col-6 col-lg-2">
            <label asp-for="EventType" class="form-label">Type</label>
            <select asp-for="EventType" class="form-select">
                <option value="">All types</option>
                <option value="Run">Run</option>
                <option value="Walk">Walk</option>
                <option value="Cycle">Cycle</option>
            </select>
        </div>
        <div class="col-6 col-lg-2">
            <label asp-for="SortBy" class="form-label">Sort by</label>
            <select asp-for="SortBy" class="form-select">
                <option value="date">Soonest first</option>
                <option value="distance">Shortest distance</option>
            </select>
        </div>
        <div class="col-lg-2">
            <div class="form-check mb-2">
                <input asp-for="IncludePast" class="form-check-input" />
                <label asp-for="IncludePast" class="form-check-label">Show past events</label>
            </div>
        </div>
        <div class="col-lg-2 d-flex gap-2">
            <button type="submit" class="btn btn-rd flex-fill">Apply</button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="Clear filters"><i class="bi bi-x-lg"></i></a>
        </div>
    </div>
</form>

@if (Model.Events.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-calendar-x"></i>
        <h2>No events found</h2>
        <p>Try a different search or clear the filters. New events are added all the time.</p>
    </div>
}
else
{
    <p class="text-muted">@Model.Events.Count event@(Model.Events.Count == 1 ? "" : "s") found</p>
    <div class="row g-4">
        @foreach (var ev in Model.Events)
        {
            <div class="col-md-6 col-lg-4">
                <partial name="_EventCard" model="ev" />
            </div>
        }
    </div>
}
